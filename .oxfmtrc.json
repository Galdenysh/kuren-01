{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "singleQuote": true,
  "trailingComma": "all",
  "printWidth": 80,
  "proseWrap": "preserve",
  "sortPackageJson": false,
  "ignorePatterns": [
    "dist",
    "node_modules",
    "package-lock.json",
    ".cursor/commands",
    ".cursor/skills/openspec-*",
    "openspec/changes/archive"
  ]
}
