{
  "name": "kuren-01",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "./scripts/with-node.sh vite",
    "build": "./scripts/with-node.sh bash -c 'tsc -b && vite build'",
    "lint": "./scripts/with-node.sh oxlint",
    "format": "./scripts/with-node.sh oxfmt",
    "format:check": "./scripts/with-node.sh oxfmt --check",
    "preview": "./scripts/with-node.sh vite preview",
    "test": "./scripts/with-node.sh vitest run --passWithNoTests",
    "test:watch": "./scripts/with-node.sh vitest",
    "agents:check": "./scripts/with-node.sh node scripts/check-agents.mjs",
    "core:imports": "./scripts/with-node.sh node scripts/check-core-imports.mjs",
    "verify": "./scripts/with-node.sh bash -c 'npm run agents:check && npm run core:imports && npm run lint && npm run format:check && npm test && npm run build'",
    "openspec": "./scripts/with-node.sh openspec"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@fission-ai/openspec": "^1.16.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
