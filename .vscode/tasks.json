{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Dev",
      "type": "npm",
      "script": "dev",
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "Local:"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "kuren"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Test",
      "type": "npm",
      "script": "test",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "kuren"
      }
    },
    {
      "label": "Agents check",
      "type": "npm",
      "script": "agents:check",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "group": "kuren"
      }
    },
    {
      "label": "Verify",
      "type": "npm",
      "script": "verify",
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "kuren"
      }
    },
    {
      "label": "Format",
      "type": "npm",
      "script": "format",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "group": "kuren"
      }
    },
    {
      "label": "Lint",
      "type": "npm",
      "script": "lint",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "group": "kuren"
      }
    },
    {
      "label": "Build",
      "type": "npm",
      "script": "build",
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "group": "kuren"
      }
    }
  ]
}
